// Application icon (resource id 1), generated by tools/make_icon.py from the Segoe UI Emoji wave.
1 ICON "MultiPing.ico"

// MinGW build only: embed the application manifest (RT_MANIFEST = 24). windres runs the C
// preprocessor, which defines __GNUC__; rc.exe does not, and the MSVC linker embeds its own.
#ifdef __GNUC__
1 24 "MultiPing.manifest"
#endif
